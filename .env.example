# Copy to .env and fill in what you have. Everything is optional:
# with no keys at all the app runs in deterministic offline stub mode.

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console

# Shared secret for the workflow routes. Leave blank to disable auth locally.
API_KEY=

# --- LLM ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Each analysis record costs ~70-90 output tokens, so LLM_MAX_TOKENS must
# clear batch_size * 90 with headroom. Too tight and the tool call truncates,
# which the API reports as a 200 with an empty payload.
LLM_BATCH_SIZE=15
LLM_MAX_TOKENS=8000
# forced | auto. Not all models support forced tool choice; the client
# negotiates down to auto on the 400 that says so. Set auto to skip that call.
LLM_TOOL_CHOICE=forced
# Set true to force the offline stub even when a key is present.
LLM_OFFLINE_MODE=false

# --- GitHub ---
# Fine-grained PAT on the target repo with BOTH:
#   Issues:   Read and write
#   Contents: Read and write   (grants push access)
# Contents looks unrelated but GitHub checks push access before applying
# labels and before allowing issue comments -- and drops labels silently.
GITHUB_TOKEN=
GITHUB_REPO=acme/product
GITHUB_SEVERITY_THRESHOLD=3

# --- Slack (Incoming Webhook URL) ---
SLACK_WEBHOOK_URL=

# Run the pipeline but skip every outbound write.
DRY_RUN=false
